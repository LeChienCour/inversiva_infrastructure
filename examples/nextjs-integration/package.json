{
  "name": "nextjs-aws-integration",
  "version": "1.0.0",
  "description": "Next.js integration example for AWS infrastructure with Cognito authentication and S3 presigned URLs",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build && next export",
    "deploy:dev": "npm run export && node deployment/deploy-to-s3.js",
    "deploy:prod": "NODE_ENV=production npm run export && ENVIRONMENT=prod node deployment/deploy-to-s3.js",
    "type-check": "tsc --noEmit",
    "analyze": "ANALYZE=true npm run build"
  },
  "dependencies": {
    "next": "^14.0.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "aws-amplify": "^6.0.0",
    "@aws-amplify/auth": "^6.0.0",
    "@aws-sdk/client-s3": "^3.450.0",
    "@aws-sdk/s3-request-presigner": "^3.450.0",
    "@aws-sdk/client-cognito-identity": "^3.450.0",
    "@aws-sdk/client-cloudfront": "^3.450.0",
    "jsonwebtoken": "^9.0.2",
    "mime-types": "^2.1.35"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/mime-types": "^2.1.0",
    "typescript": "^5.2.0",
    "eslint": "^8.50.0",
    "eslint-config-next": "^14.0.0",
    "tailwindcss": "^3.3.0",
    "autoprefixer": "^10.4.0",
    "postcss": "^8.4.0",
    "@tailwindcss/forms": "^0.5.0",
    "webpack-bundle-analyzer": "^4.9.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "keywords": [
    "nextjs",
    "aws",
    "cognito",
    "s3",
    "terraform",
    "authentication",
    "presigned-urls",
    "cloudfront"
  ],
  "author": "Your Name",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/your-repo.git"
  },
  "bugs": {
    "url": "https://github.com/your-username/your-repo/issues"
  },
  "homepage": "https://github.com/your-username/your-repo#readme"
}