# Environment Variables Template for Next.js Integration
# Copy this file to .env.local and update with your actual values

# =============================================================================
# AWS Configuration
# =============================================================================

# AWS Region where your infrastructure is deployed
NEXT_PUBLIC_AWS_REGION=us-east-1

# =============================================================================
# Cognito Configuration
# =============================================================================

# Cognito User Pool ID (from Terraform output: cognito_user_pool_id)
NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX

# Cognito User Pool Client ID (from Terraform output: cognito_user_pool_client_id)
NEXT_PUBLIC_COGNITO_USER_POOL_CLIENT_ID=XXXXXXXXXXXXXXXXXXXXXXXXXX

# Cognito Identity Pool ID (from Terraform output: cognito_identity_pool_id)
NEXT_PUBLIC_COGNITO_IDENTITY_POOL_ID=us-east-1:XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX

# Cognito Domain for OAuth (from Terraform output: cognito_domain)
NEXT_PUBLIC_COGNITO_DOMAIN=my-app-dev.auth.us-east-1.amazoncognito.com

# =============================================================================
# OAuth Configuration
# =============================================================================

# OAuth Redirect URI for successful login
NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback

# OAuth Logout URI
NEXT_PUBLIC_OAUTH_LOGOUT_URI=http://localhost:3000/auth/logout

# =============================================================================
# S3 Configuration
# =============================================================================

# S3 Website Bucket Name (from Terraform output: s3_website_bucket_name)
NEXT_PUBLIC_S3_WEBSITE_BUCKET=my-app-dev-website-abc123

# S3 Content Bucket Name (from Terraform output: s3_content_bucket_name)
NEXT_PUBLIC_S3_CONTENT_BUCKET=my-app-dev-content-abc123

# =============================================================================
# CloudFront Configuration
# =============================================================================

# CloudFront Distribution ID (from Terraform output: cloudfront_distribution_id)
NEXT_PUBLIC_CLOUDFRONT_DISTRIBUTION_ID=E1234567890123

# CloudFront Domain Name (from Terraform output: cloudfront_domain_name)
NEXT_PUBLIC_CLOUDFRONT_DOMAIN=d1234567890123.cloudfront.net

# Custom Domain (if configured)
NEXT_PUBLIC_CUSTOM_DOMAIN=placeholder.mx

# =============================================================================
# Application Configuration
# =============================================================================

# Environment (dev, staging, prod)
NEXT_PUBLIC_ENVIRONMENT=dev

# Application Name
NEXT_PUBLIC_APP_NAME=My Next.js App

# API Base URL (for backend API calls)
NEXT_PUBLIC_API_BASE_URL=https://api.placeholder.mx

# =============================================================================
# Development Configuration (for local development only)
# =============================================================================

# Local development OAuth redirect (for localhost)
NEXT_PUBLIC_OAUTH_REDIRECT_URI_DEV=http://localhost:3000/auth/callback

# Local development logout URI
NEXT_PUBLIC_OAUTH_LOGOUT_URI_DEV=http://localhost:3000/auth/logout

# =============================================================================
# Deployment Configuration (for deployment scripts)
# =============================================================================

# AWS Region for deployment
AWS_REGION=us-east-1

# S3 Website Bucket for deployment
S3_WEBSITE_BUCKET=my-app-dev-website-abc123

# CloudFront Distribution ID for invalidation
CLOUDFRONT_DISTRIBUTION_ID=E1234567890123

# Build directory (Next.js static export)
BUILD_DIR=.next/out

# Environment for deployment
ENVIRONMENT=dev

# Delete old files during deployment
DELETE_OLD_FILES=false

# Create CloudFront invalidation after deployment
CREATE_INVALIDATION=true

# =============================================================================
# Security Configuration
# =============================================================================

# Content Security Policy settings
NEXT_PUBLIC_CSP_REPORT_URI=https://api.placeholder.mx/csp-report

# =============================================================================
# Feature Flags
# =============================================================================

# Enable/disable features based on environment
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_DEBUG_MODE=true
NEXT_PUBLIC_ENABLE_OFFLINE_MODE=false

# =============================================================================
# Content Configuration
# =============================================================================

# Maximum file upload size (in bytes)
NEXT_PUBLIC_MAX_UPLOAD_SIZE=10485760

# Allowed file types for upload
NEXT_PUBLIC_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf,text/plain

# Presigned URL expiration time (in seconds)
NEXT_PUBLIC_PRESIGNED_URL_EXPIRY=900

# =============================================================================
# Monitoring and Analytics
# =============================================================================

# Google Analytics ID (if using)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Sentry DSN (if using)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx

# =============================================================================
# Instructions for Getting Values
# =============================================================================

# To get the actual values for these environment variables:
#
# 1. Deploy your infrastructure using Terragrunt:
#    cd environments/dev (or prod)
#    terragrunt run-all apply
#
# 2. Get the output values:
#    terragrunt run-all output
#
# 3. Update this file with the actual values from the Terraform outputs
#
# 4. For local development, use localhost URLs for OAuth redirects
#
# 5. For production, use your actual domain URLs

# =============================================================================
# Environment-Specific Examples
# =============================================================================

# Development Environment Example:
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_ABC123DEF
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=http://localhost:3000/auth/callback
# NEXT_PUBLIC_ENVIRONMENT=dev

# Production Environment Example:
# NEXT_PUBLIC_COGNITO_USER_POOL_ID=us-east-1_XYZ789GHI
# NEXT_PUBLIC_OAUTH_REDIRECT_URI=https://placeholder.mx/auth/callback
# NEXT_PUBLIC_ENVIRONMENT=prod