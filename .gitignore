# Terraform files
*.tfstate
*.tfstate.*
*.tfplan
.terraform/

# Terraform lock files - IMPORTANT: These should be committed!
# .terraform.lock.hcl files are intentionally NOT ignored
# They ensure consistent provider versions across environments

# Terraform variable files (contain sensitive data)
# Note: terraform.tfvars files are committed as they contain environment configuration
# Only ignore sensitive/local override files
*.auto.tfvars
secrets.tfvars
sensitive.tfvars
private.tfvars
local.tfvars
*.local.tfvars

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# IDE files
.vscode/
.idea/
*.swp
*.swo
*~

# Logs
*.log

# Environment variables
.env
.env.local
.env.*.local

# AWS credentials (should never be committed)
.aws/
aws-credentials.json

# Temporary files
tmp/
temp/
*.tmp

# Backup files
*.bak
*.backup

# Node.js (if any helper scripts use Node)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python (if any helper scripts use Python)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/

# Local Terraform override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Terraform debug files
terraform-debug.log

# Certificate files (should be managed by ACM)
*.pem
*.key
*.crt
*.csr

# Local development files
.local/
local/

# Terraform crash logs
crash.log
crash.*.log

# Terraform plan output files
*.tfplan
*.tfplan.*

# Terraform state backup files
terraform.tfstate.backup
terraform.tfstate.*.backup

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Terraform plugin cache
.terraform.d/

# Ignore any local testing or development scripts
test-*.sh
test-*.ps1
dev-*.sh
dev-*.ps1

# Ignore local configuration overrides (already covered above)
# local.tfvars, *.local.tfvars, secrets.tfvars, etc.